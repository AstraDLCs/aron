# Variables de la API. En Dokploy se cargan en la pestaña "Environment" del servicio Compose.
# En local: copiar a `.env` (ignorado por git), junto a docker-compose.yml, y ajustar.

# --- Obligatorias -----------------------------------------------------------------------------------
# Al menos 32 caracteres. Generar con:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR-por-valor-aleatorio
# Contraseña de PostgreSQL: solo letras, números, - o _ (va dentro de la URL de conexión).
# Se fija la primera vez que arranca la base; cambiarla después no cambia la de la base ya creada.
POSTGRES_PASSWORD=CAMBIAR-por-valor-aleatorio

# --- Registro de cuentas ----------------------------------------------------------------------------
# invite (recomendado en servidor): solo se registra quien tenga INVITE_CODE. Sin código, nadie puede.
# open: cualquiera que llegue al servidor puede crear una cuenta y ver todos los CVs.
REGISTRATION_MODE=invite
INVITE_CODE=

# --- IA (OpenRouter, modelos gratuitos) -------------------------------------------------------------
# Sin clave, los CVs quedan "Sin IA" (solo puntaje por reglas).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WORKER_RATE_PER_MINUTE=15

# --- Borrado total (solo versión de prueba) ---------------------------------------------------------
# true: cualquier usuario puede borrar TODOS los datos y CVs desde la app con Ctrl+Alt+B (con confirmación).
# Poner false cuando la app pase a uso real.
ALLOW_WIPE=true

# --- Opcionales -------------------------------------------------------------------------------------
# POSTGRES_USER=pulso
# POSTGRES_DB=pulso
# JWT_EXPIRE_HOURS=12
# SERVER_SCAN_INTERVAL_S=300
# COMPANY_NAME_DEFAULT=Compañía Minera Las Bravas
# Orígenes permitidos (JSON). Por defecto, los de la app de escritorio Tauri.
# CORS_ORIGINS=["http://tauri.localhost","tauri://localhost"]
# Proxies de confianza para la IP que se guarda en la bitácora. Nunca '*' (permite falsificar la IP).
# En Dokploy, la subred de Traefik:  docker network inspect dokploy-network -f '{{(index .IPAM.Config 0).Subnet}}'
# FORWARDED_ALLOW_IPS=10.0.1.0/24

# --- Solo desarrollo local (no poner en Dokploy) ----------------------------------------------------
# Para que `docker compose up` use también docker-compose.dev.yml (separador ; en Windows, : en Linux/Mac):
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
# COMPOSE_PATH_SEPARATOR=;
